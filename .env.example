# ==========================================
# Configuración de Entorno - MoneyVault
# ==========================================

# PUERTO DE LA APLICACIÓN WEB (Frontend Nginx)
APP_PORT=8888

# PUERTO DEL BACKEND (API / Swagger UI)
BACKEND_PORT=8085

# CONFIGURACIÓN DE BASE DE DATOS MYSQL
MYSQL_DATABASE=finanzas_db
MYSQL_USER=finanzas_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_mysql_password_here

# CLAVE DE SEGURIDAD JWT (Mínimo 256 bits / 32 bytes codificados en Base64)
# Generar con: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=PPp27xSTfBwOpRn4/AV6gPzQSnQg+Oi80KdWfCcuAHs=
JWT_EXPIRATION_MS=86400000

# ORÍGENES PERMITIDOS EN CORS (Separados por coma, ej: https://my-finance-mv.enriquebalcazar.com)
CORS_ALLOWED_ORIGINS=https://my-finance-mv.enriquebalcazar.com,https://*.enriquebalcazar.com,http://localhost:8888,http://localhost:5173
