# ==========================================
# Configuración de Despliegue de MoneyVault
# ==========================================

# PUERTO DE LA APLICACIÓN WEB
# Cambia este valor al puerto que prefieras para evitar choques con otros servicios en tu servidor Ubuntu.
# Ejemplos: 8888, 9090, 7777, 8585, 9595, etc.
APP_PORT=8888

# PUERTO DEL BACKEND (OPCIONAL/SWAGGER UI)
# Puerto expuesto para el backend Spring Boot (ej: 8085, 8086)
BACKEND_PORT=8085

# CONFIGURACIÓN DE BASE DE DATOS MYSQL (Aislada en su contenedor)
MYSQL_DATABASE=finanzas_db
MYSQL_USER=finanzas_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_mysql_password_here

# CLAVE DE SEGURIDAD JWT (Cambiar por un secreto largo en producción, mín 256 bits)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_256_bits_long_change_in_production_12345
JWT_EXPIRATION_MS=86400000
